<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/exchange_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/exchange_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_country"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="@string/exchange_widget_heading"
        android:textColor="@color/exchange_widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_currency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textColor="@color/exchange_widget_support"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/widget_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="26sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:maxLines="1"
        android:textColor="@color/exchange_widget_rate"
        android:textSize="26sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/exchange_widget_loading"
        android:textColor="@color/exchange_widget_support"
        android:textSize="11sp" />
    <ImageView
        android:id="@+id/widget_graph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scaleType="fitXY"
        android:visibility="gone" />
</LinearLayout>
